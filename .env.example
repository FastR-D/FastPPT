# FastPPT v1.1.0 local profile
FASTPPT_DEPLOYMENT_MODE=local
FASTPPT_HOST=127.0.0.1
FASTPPT_PORT=43110
FASTPPT_DATA_DIR=./var/data
FASTPPT_TEMP_DIR=./var/tmp
FASTPPT_EXPORT_DIR=./var/exports
FASTPPT_RENDER_BACKEND=unavailable
FASTPPT_BILLING_MODE=disabled

# Agent Harness: deterministic_test is for local smoke tests only.
FASTPPT_AGENT_BACKEND=deterministic_test
FASTPPT_MODEL=fastppt-deterministic
FASTPPT_MODEL_ENDPOINT_MODE=official

# Real Agent example. Keys stay in the untracked .env or secret store.
# FASTPPT_AGENT_BACKEND=codex
# FASTPPT_MODEL=replace-with-a-supported-model
# FASTPPT_MODEL_API_KEY=

# Compatible HTTPS relay example.
# FASTPPT_MODEL_ENDPOINT_MODE=relay
# FASTPPT_MODEL_BASE_URL=https://relay.example.com/v1

# GPT-image-2 uses the same official/relay endpoint contract. The browser
# never receives this key; production deployments should use a secret store.
FASTPPT_IMAGE_MODEL=gpt-image-2
FASTPPT_IMAGE_ENDPOINT_MODE=official
FASTPPT_IMAGE_PROTOCOL=openai_images
# FASTPPT_IMAGE_API_KEY=
# FASTPPT_IMAGE_ENDPOINT_MODE=relay
# FASTPPT_IMAGE_BASE_URL=https://relay.example.com
