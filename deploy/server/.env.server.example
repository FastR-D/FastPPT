FASTPPT_DOMAIN=fastppt.example.com
FASTPPT_POSTGRES_PASSWORD=replace-with-a-long-random-password
FASTPPT_S3_ACCESS_KEY=replace-with-a-random-access-key
FASTPPT_S3_SECRET_KEY=replace-with-a-long-random-secret
FASTPPT_SESSION_SECRET=
FASTPPT_ADMIN_EMAIL=admin@example.com
FASTPPT_ADMIN_PASSWORD=replace-with-a-long-random-password

# Agent SDK: codex or claude_code.
FASTPPT_AGENT_BACKEND=codex
FASTPPT_MODEL=replace-with-a-supported-model
FASTPPT_MODEL_ENDPOINT_MODE=official
FASTPPT_MODEL_API_KEY=

# For an HTTPS-compatible relay, switch endpoint mode and set its base URL.
# FASTPPT_MODEL_ENDPOINT_MODE=relay
# FASTPPT_MODEL_BASE_URL=https://relay.example.com/v1

# Use powerpoint only when an independent Windows Render Worker is connected.
FASTPPT_RENDER_BACKEND=unavailable
