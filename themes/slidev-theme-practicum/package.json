{
  "name": "slidev-theme-practicum",
  "version": "0.1.3-fastppt.1",
  "private": true,
  "description": "Strict Slidev presentation theme with a 12x12 grid, editorial layouts, and low-level slot composition API",
  "keywords": [
    "slidev-theme",
    "slidev",
    "practicum",
    "education",
    "grid",
    "editorial"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://ssh.sourcecraft.dev/veged/slidev-theme-practicum.git"
  },
  "files": [
    "components",
    "composables",
    "scripts",
    "layouts",
    "public",
    "setup",
    "styles",
    "types",
    "skills",
    "LICENSE",
    "README.md",
    "example.md",
    "decor-library.md"
  ],
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1920,
      "favicon": "/theme/favicon.svg",
      "fonts": {
        "provider": "none",
        "sans": "YS Text, Inter, Noto Sans SC",
        "mono": "monospace",
        "local": [
          "YS Text",
          "Inter",
          "Noto Sans SC",
          "monospace"
        ]
      }
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "slidev": ">=0.50.0"
  },
  "bin": {
    "slidev-practicum-validate": "scripts/validate-deck.cjs"
  },
  "scripts": {
    "dev": "slidev example.md",
    "dev:decor": "slidev decor-library.md",
    "build": "node ../../scripts/theme-build.mjs .",
    "build:decor": "slidev build decor-library.md --out dist/decor-library",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "validate-deck": "node scripts/validate-deck.cjs",
    "test": "node ../../scripts/theme-smoke.mjs .",
    "typecheck": "vue-tsc --noEmit",
    "test:architecture": "node scripts/check-test-architecture.mjs",
    "test:unit": "node --test tests/*.test.cjs",
    "test:validate-deck": "node scripts/validate-deck.cjs example.md",
    "test:build": "slidev build example.md",
    "test:build-artifact": "node scripts/check-build-artifact.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "author": "",
  "type": "commonjs",
  "dependencies": {
    "@slidev/parser": "^52.14.2",
    "@slidev/types": "^52.14.2",
    "markdown-it": "^14.1.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.13",
    "@fastppt/fonts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@eslint/js": "^10.0.1",
    "@slidev/cli": "^52.14.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.5.0",
    "playwright-chromium": "^1.59.1",
    "postcss": "^8.5.9",
    "typescript-eslint": "^8.58.2",
    "vite": "catalog:",
    "vue-tsc": "^3.2.7"
  }
}
