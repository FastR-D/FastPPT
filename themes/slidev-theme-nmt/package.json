{
  "name": "slidev-theme-nmt",
  "version": "0.9.10-fastppt.1",
  "private": true,
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=22.0.0",
    "slidev": ">=0.49.0"
  },
  "dependencies": {
    "unocss": "^66.3.3",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-regular": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@slidev/types": "^0.50.0-beta.5",
    "@unocss/preset-icons": "^66.6.8",
    "codemirror-theme-vars": "^0.1.1",
    "prism-theme-vars": "^0.2.4",
    "slidev-addon-sync": "^0.1.0",
    "slidev-component-poll": "^3.0.0",
    "theme-vitesse": "^0.6.2",
    "@fastppt/fonts": "workspace:*"
  },
  "devDependencies": {
    "@slidev/cli": "^0.50.0-beta.5",
    "@types/node": "^18.13.0"
  },
  "//": "Learn more: https://sli.dev/themes/write-a-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Lexend,Noto Sans SC",
        "serif": "Roboto Serif,Georgia",
        "mono": "Fira Code,consolas",
        "local": "Lexend,Noto Sans SC,Fira Code",
        "italic": false
      },
      "transition": "fade",
      "aspectRatio": "16/10"
    }
  },
  "author": "Adrian Gould <ady.g.coder@gmail.com>",
  "funding": "https://github.com/sponsors/adygcode",
  "bugs": "https://github.com/adygcode/slidev-theme-nmt/issues",
  "scripts": {
    "test": "node ../../scripts/theme-smoke.mjs .",
    "build": "node ../../scripts/theme-build.mjs .",
    "dev": "slidev example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  }
}
