{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModifyRequest",
  "type": "object",
  "required": ["scope", "targets", "baseRevisions", "intent", "mode", "exportAfter"],
  "properties": {
    "scope": {"enum": ["selection", "region", "page", "pages", "deck"]},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide"],
        "properties": {
          "slide": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
          "elementRefs": {"type": "array", "items": {"$ref": "revision.schema.json#/$defs/elementRef"}},
          "region": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}},
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "baseRevisions": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
    "intent": {"type": "string", "minLength": 1},
    "mode": {"enum": ["direct", "agent", "auto"]},
    "exportAfter": {"type": "boolean"}
  },
  "additionalProperties": false
}
