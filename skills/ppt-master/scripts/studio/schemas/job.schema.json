{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudioJob",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "owningLayer", "requiresApproval", "scope", "targets", "baseRevisions", "intent", "mode", "exportAfter"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobId": {"type": "string", "pattern": "^job_"},
    "status": {"enum": ["queued", "waiting_workflow", "analyzing", "awaiting_approval", "approved", "waiting_agent", "executing", "validating", "committing", "exporting", "summarizing", "completed", "conflict", "failed", "rolled_back", "canceled"]},
    "owningLayer": {"enum": ["page", "spec", "plan", "sidecar", "export"]},
    "requiresApproval": {"type": "boolean"},
    "waitingWorkflow": {"type": "boolean"},
    "scope": {"enum": ["selection", "region", "page", "pages", "deck"]},
    "targets": {"type": "array", "minItems": 1},
    "baseRevisions": {"type": "object"},
    "intent": {"type": "string", "minLength": 1},
    "mode": {"enum": ["direct", "agent", "auto"]},
    "exportAfter": {"type": "boolean"}
  },
  "additionalProperties": true
}
