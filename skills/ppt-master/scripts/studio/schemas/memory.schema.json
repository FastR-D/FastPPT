{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryCandidate",
  "type": "object",
  "required": ["schemaVersion", "candidateId", "scope", "trigger", "lesson", "evidence", "exceptions", "confidence", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "candidateId": {"type": "string", "pattern": "^mem_"},
    "scope": {"enum": ["page", "project", "global"]},
    "slide": {"type": "string"},
    "trigger": {"type": "string", "minLength": 1},
    "lesson": {"type": "string", "minLength": 1},
    "evidence": {"type": "object"},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["proposed", "accepted", "rejected", "withdrawn"]}
  },
  "additionalProperties": false
}
