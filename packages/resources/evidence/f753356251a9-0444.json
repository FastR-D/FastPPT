rgency-management scenarios.","box":[0.0721,0.2611,0.8322,0.316]},{"anchor":"s663-s662","text":"From Crisis Management to Solution Management","box":[0.0717,0.1724,0.5893,0.0591]},{"anchor":"s2","text":"From Crisis Management to Solution Management","box":[0.0283,0.0378,0.9417,0.0673]}],"warnings":[],"stats":{"objects":35,"textBlocks":11},"reconstructedSlots":[{"anchor":"text-0","text":"Crisis ","box":[0.11489053198290142,0.8879578201859085,0.031216321720767548,0.018529595269097223],"origin":[0.11489053198290142,0.902781507703993],"font":"DejaVuSans","size":10.005999565124512,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-1","text":"Management","box":[0.09457614998478904,0.9101633707682292,0.06857171035670565,0.018529595269097223],"origin":[0.09457614998478904,0.9249870582863137],"font":"DejaVuSans","size":10.005999565124512,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-2","text":"Solution ","box":[0.8476978687814292,0.8879578201859085,0.04569358301128599,0.018529595269097223],"origin":[0.8476978687814292,0.902781507703993],"font":"DejaVuSans","size":10.005999565124512,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-3","text":"Management","box":[0.8346771637623861,0.9101633707682292,0.06857168651508269,0.018529595269097223],"origin":[0.8346771637623861,0.9249870582863137],"font":"DejaVuSans","size":10.005999565124512,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-4","text":"Crisis","box":[0.49729823549737917,0.8881152117693866,0.0280165454505574,0.018529595269097223],"origin":[0.49729823549737917,0.9029388992874711],"font":"DejaVuSans","size":10.005999565124512,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-5","text":"Practice ","box":[0.1078041420210512,0.7585096571180555,0.04494317587583791,0.018529595269097223],"origin":[0.1078041420210512,0.77333334463614],"font":"DejaVuSans","size":10.005999565124512,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-6","text":"prevention","box":[0.10051046504198193,0.7807152077003762,0.05608514511124342,0.018529595269097223]