e organization. What is deemed important often depends on the department measuring the performance – e.g. the KPIs useful to finance will differ from the KPIs assigned to sales.","box":[0.6278,0.3542,0.3104,0.5124]},{"anchor":"s544-s543","text":"Most Important Project Management Key Performance Indicators KPI","box":[0.6264,0.1661,0.3039,0.1623]},{"anchor":"s2","text":"Most Important Project Management Key Performance Indicators KPI","box":[0.0283,0.0378,0.9417,0.0673]}],"warnings":[],"stats":{"objects":26,"textBlocks":11},"reconstructedSlots":[{"anchor":"text-0","text":"•","box":[0.0980302845831483,0.2338689027009187,0.0046227238005200014,0.023149998982747395],"origin":[0.0980302845831483,0.2523889047128183],"font":"OpenSymbol","size":12.50100040435791,"resolvedFamily":"OpenSymbol"},{"anchor":"text-1","text":" ","box":[0.1026530083836683,0.2338689027009187,0.005682380627378004,0.02703330428512008],"origin":[0.1026530083836683,0.2523889047128183],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-2","text":"Cycle time","box":[0.1083353890110463,0.23775222213179978,0.06909341275030922,0.023149984854239004],"origin":[0.1083353890110463,0.25627221001519096],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-3","text":"•","box":[0.0980302845831483,0.26168924967447915,0.0046227238005200014,0.023149984854239004],"origin":[0.0980302845831483,0.28020923755787036],"font":"OpenSymbol","size":12.50100040435791,"resolvedFamily":"OpenSymbol"},{"anchor":"text-4","text":" ","box":[0.1026530083836683,0.26168924967447915,0.005682380627378004,0.027035211633752894],"origin":[0.1026530083836683,0.28020923755787036],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-5","text":"On-time completion ","box":[0.1083353890110463,0.26557447645399307,0.13339479438825416,0.023149984854239004],"origin":[0.1083353890110463,0.2840944643373843],"font":"DejaVuSans","size":12.5