el, and communication).","box":[0.0757,0.2231,0.8226,0.2599]},{"anchor":"s3","text":"Marketing Mix","box":[0.0283,0.0378,0.9417,0.0673]}],"warnings":[],"stats":{"objects":21,"textBlocks":11},"reconstructedSlots":[{"anchor":"text-0","text":"Promotion","box":[0.14196734397008798,0.6535003662109375,0.06612442339034873,0.023150013111255786],"origin":[0.14196734397008798,0.6720203540943287],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-1","text":"Product","box":[0.36717138852658454,0.6535003662109375,0.049352445625999955,0.023150013111255786],"origin":[0.36717138852658454,0.6720203540943287],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-2","text":"Price","box":[0.5919628935338022,0.6535003662109375,0.031734026668921556,0.023150013111255786],"origin":[0.5919628935338022,0.6720203540943287],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-3","text":"Place","box":[0.8066555638877613,0.6535003662109375,0.034546702401550784,0.023150013111255786],"origin":[0.8066555638877613,0.6720203540943287],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-4","text":"Measures of the 4Ps Must be Coordinated ","box":[0.3608235405191561,0.5572281448929398,0.274641731931785,0.023150013111255786],"origin":[0.3608235405191561,0.575748132776331],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-5","text":"The target audience ","box":[0.10936871673894917,0.745731834129051,0.13568661013129105,0.023150013111255786],"origin":[0.10936871673894917,0.7642518220124421],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamily":"DejaVu Sans"},{"anchor":"text-6","text":"should be informed","box":[0.11208535046708919,0.7735004001193576,0.12597238059241028,0.023150013111255786],"origin":[0.11208535046708919,0.7920203880027489],"font":"DejaVuSans","size":12.50100040435791,"resolvedFamil