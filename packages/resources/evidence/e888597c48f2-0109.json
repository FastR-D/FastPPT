83130787],"origin":[0.3381164609240568,0.3487148143627025],"font":"ArialMT","size":10.005999565124512,"resolvedFamily":"Arial"},{"anchor":"text-46","text":"领导视察","box":[0.05551091167505203,0.1716641037552445,0.08347007828635315,0.03706111201533565],"origin":[0.05551091167505203,0.20131299054181134],"font":"MicrosoftYaHei-Bold","size":20.01300048828125,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-47","text":"坚持以人民为中心，不断提升服务质量","box":[0.05551091167505203,0.4316437332718461,0.2484924464970139,0.025931464301215276],"origin":[0.05551091167505203,0.4523889047128183],"font":"MicrosoftYaHei-Bold","size":14.003000259399414,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-48","text":"王书记强调，事业单位是联系群众的重要纽带。要深入了解群众需求，创","box":[0.05551091167505203,0.4764615094220197,0.33398319769569124,0.018529595269097223],"origin":[0.05551091167505203,0.49128519694010414],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-49","text":"新服务方式，提高工作效率，让群众切实感受到事业单位的温度。他特别","box":[0.05551091167505203,0.5031281647858796,0.333982148664281,0.018529595269097223],"origin":[0.05551091167505203,0.5179518523039641],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-50","text":"指出，要关注老年人、残疾人等特殊群体的需求，确保服务全面覆盖。","box":[0.05551091167505203,0.5296374285662616,0.32172593323264753,0.018529595269097223],"origin":[0.05551091167505203,0.5444611160843461],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-51","text":"加强队伍建设，提升专业能力","box":[0.05551091167505203,0.6024048416702835,0.19005969624500796,0.025931464301215276],"origin":[0.05551091167505203,0.6231500131112558],"font":"MicrosoftYaHei-Bold","size":14.003000259399414,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-52","text":"高素质的人才队伍是事业单位发展的根本保障。要注重人才培养，完善培","box":[0.05551091167505203,0.6470133463541666,0.33398319769569124,0.018529595269097223],"origin":[0.05551091167505203,0.6618370338722511],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-53","text":"训机制，打造一支政治过硬、业务精通的高素质专业化队伍。他建议我们","box":[0.05551091167505203,0.6736800017180267,0.33398319769569124,0.018529595269097223],"origin":[0.05551091167505203,0.6885036892361112],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-54","text":"可以与高校合作，建立人才培养基地，为单位持续输送新鲜血液。","box":[0.05551091167505203,0.7003467135959202,0.3008532916857267,0.018529595269097223],"origin":[0.05551091167505203,0.7151704011140047],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-55","text":"推进改革创新，增强发展动力","box":[0.05551091167505203,0.772954813639323,0.19005969624500796,0.025931464301215276],"origin":[0.05551091167505203,0.7936999850802952],"font":"MicrosoftYaHei-Bold","size":14.003000259399414,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-56","text":"面对新时代的挑战，王书记要求我们要主动适应新形势新要求，深化内部","box":[0.05551091167505203,0.8175651832863137,0.3339831659068606,0.018529595269097223],"origin":[0.05551091167505203,0.8323888708043982],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-57","text":"管理改革，优化业务流程，提高资源利用效率。他特别强调要充分运用信","box":[0.05551091167505203,0.8442318951642072,0.3339831659068606,0.018529595269097223],"origin":[0.05551091167505203,0.8590555826822917],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"},{"anchor":"text-58","text":"息化手段，推动传统业务向智能化、数字化转型。","box":[0.05551091167505203,0.8708985505280671,0.22824569523603047,0.018529595269097223],"origin":[0.05551091167505203,0.8857222380461516],"font":"MicrosoftYaHei","size":10.005999565124512,"resolvedFamily":"Microsoft YaHei"}],"brandingCleanup":{"id":"e888597c48f2-0109","beforeMarkdownSha256":"7ead2f88f1fee3f4f928f580c4c7c6ae172c6a0cf78dfde41cb5f4f31a849ff6","afterMarkdownSha256":"68426819b6afd25e0884aef59c553617255dc78659fd1cf34c5d7b2a1033ef31","edits":[{"a